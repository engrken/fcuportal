generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEACHER
  STUDENT
}

enum GradeStatus {
  DRAFT
  SUBMITTED
  VERIFIED
}

enum SchoolPlan {
  FREE
  PREMIUM
  ENTERPRISE
}

model School {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  shortName            String
  portalTitle          String   @default("Student Grade Portal")
  logoText             String   @default("S")
  primaryColor         String   @default("#2457d6")
  logoPath             String?
  privacyController    String?
  privacyContactEmail  String?
  privacyPolicyUrl     String?
  isActive             Boolean  @default(true)
  plan                 SchoolPlan @default(FREE)
  subscriptionStatus   String   @default("ACTIVE")
  subscriptionExpiresAt DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  users                User[]
  subjects             Subject[]
  studentDirectory     StudentDirectory[]
  tenantPayments       TenantPayment[]
}

model TenantPayment {
  id          String   @id @default(cuid())
  schoolId    String
  amount      Float
  currency    String   @default("PHP")
  method      String
  reference   String?
  paidAt      DateTime @default(now())
  coverageFrom DateTime?
  coverageTo  DateTime?
  note        String?
  recordedBy  String
  createdAt   DateTime @default(now())
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@index([schoolId, paidAt])
}

model User {
  id            String       @id @default(cuid())
  email         String
  passwordHash  String
  passwordChangedAt DateTime?
  role          Role
  schoolId      String
  fullName      String
  profileImagePath String?
  studentNumber String?
  courseProgram String?
  yearLevel     String?
  privacyNoticeAcceptedAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  subjects      Subject[]    @relation("TeacherSubjects")
  enrollments   Enrollment[] @relation("StudentEnrollments")
  auditEvents   AuditEvent[]
  passwordResetTokens PasswordResetToken[]
  @@unique([schoolId, email])
  @@unique([schoolId, studentNumber])
  @@index([schoolId, role])
}

model StudentDirectory {
  schoolId      String
  studentNumber String
  firstName     String
  middleName    String?
  lastName      String
  fullName      String
  email         String
  courseProgram String
  yearLevel     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@id([schoolId, studentNumber])
  @@unique([schoolId, email])
}

model Subject {
  id           String       @id @default(cuid())
  schoolId     String
  teacherId    String
  code         String
  classId      String?
  title        String
  term         String
  academicYear String
  schedule     String?
  courseYear   String?
  isPublished  Boolean      @default(false)
  gradeStatus  GradeStatus  @default(DRAFT)
  submittedAt  DateTime?
  verifiedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teacher      User         @relation("TeacherSubjects", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  categories   GradeCategory[]
  gradeBands   GradeBand[]
  assessments  Assessment[]
  @@index([schoolId, teacherId, academicYear, term])
  @@index([schoolId, gradeStatus, submittedAt])
  @@unique([schoolId, classId])
}

model GradeBand {
  id          String  @id @default(cuid())
  subjectId   String
  minPercent  Float
  finalGrade  String
  remarks     String
  sortOrder   Int     @default(0)
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@unique([subjectId, finalGrade])
  @@index([subjectId, minPercent])
}

model Enrollment {
  id            String       @id @default(cuid())
  subjectId     String
  studentUserId String?
  studentName   String
  studentNumber String?
  remarks       String?
  createdAt     DateTime     @default(now())
  subject       Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  student       User?        @relation("StudentEnrollments", fields: [studentUserId], references: [id], onDelete: SetNull)
  scores        Score[]
  @@unique([subjectId, studentNumber])
  @@index([subjectId, studentName])
  @@index([studentUserId])
}

model GradeCategory {
  id          String      @id @default(cuid())
  subjectId   String
  parentId    String?
  name        String
  weight      Float
  conversionBase Float    @default(50)
  sortOrder   Int         @default(0)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent      GradeCategory? @relation("GradeCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    GradeCategory[] @relation("GradeCategoryTree")
  assessments Assessment[]
  @@unique([subjectId, name])
  @@index([subjectId, parentId, sortOrder])
}

model Assessment {
  id         String        @id @default(cuid())
  subjectId  String
  categoryId String
  title      String
  maxScore   Float
  weight     Float?
  dueDate    DateTime?
  scheduleOverrideReason String?
  createdAt  DateTime      @default(now())
  subject    Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  category   GradeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  scores     Score[]
  @@index([subjectId, categoryId])
}

model Score {
  id           String     @id @default(cuid())
  enrollmentId String
  assessmentId String
  points       Float?
  remark       String?
  updatedAt    DateTime   @updatedAt
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  @@unique([enrollmentId, assessmentId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  @@index([actorId, createdAt])
}

model AuthThrottle {
  key       String   @id
  attempts  Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
  @@index([resetAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
