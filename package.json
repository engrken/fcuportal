{
  "name": "fcu-student-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then prisma migrate status; fi && prisma generate && npm run test:grades && npm run test:classes && npm run test:simulation && next build",
    "test:grades": "node --test tests/grades.test.cjs",
    "test:classes": "node --test tests/class-navigation.test.cjs",
    "postinstall": "prisma generate",
    "start": "next start",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate deploy",
    "test:simulation": "node --test tests/grade-simulation.test.cjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.2",
    "bootstrap": "^5.3.8",
    "jose": "^6.0.10",
    "next": "16.4.6",
    "nodemailer": "^10.4.0",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "dotenv": "^16.4.7",
    "prisma": "^7.10.1",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "zod": "$zod"
  }
}
