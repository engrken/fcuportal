{
  "name": "fcu-student-portal",
  "version": "0.5.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then prisma migrate status; fi && prisma generate && npm run test:grades && npm run test:classes && npm run test:simulation && npm run test:scorebook-layout && npm run test:tenant && npm run test:teacher-signup && npm run test:identity && npm run test:invites && npm run test:release && npm run test:theme && npm run test:demo && next build",
    "test:grades": "node --test tests/grades.test.cjs",
    "test:classes": "node --test tests/class-navigation.test.cjs",
    "postinstall": "prisma generate",
    "start": "next start",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate deploy",
    "test:simulation": "node --test tests/grade-simulation.test.cjs",
    "test:scorebook-layout": "node --test tests/scorebook-layout.test.cjs tests/fcu-grade-format.test.cjs",
    "test:tenant": "node --test tests/tenant-operations.test.cjs",
    "test:teacher-signup": "node --test tests/teacher-school-registration.test.cjs",
    "test:identity": "node --test tests/account-identity.test.cjs",
    "version:fix": "node scripts/bump-release.mjs fix",
    "version:feature": "node scripts/bump-release.mjs feature",
    "version:major": "node scripts/bump-release.mjs major",
    "test:release": "node --test tests/footer-version.test.cjs",
    "test:invites": "node --test tests/class-invite-code.test.cjs",
    "test:theme": "node --test tests/theme-palette.test.cjs",
    "test:demo": "node --test tests/demo-experience.test.cjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.2",
    "bootstrap": "^5.3.8",
    "jose": "^6.0.10",
    "next": "16.4.6",
    "nodemailer": "^10.4.0",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "dotenv": "^16.4.7",
    "prisma": "^7.10.1",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "zod": "$zod"
  }
}
